<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="020-create-case-table" author="devjoaopr">
        <createTable tableName="cases">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="entity_names" type="varchar(150)">
                <constraints nullable="false"/>
            </column>
            <column name="entity_id" type="uuid">
                <constraints nullable="false"/>
            </column>
            <column name="name" type="varchar(150)">
                <constraints nullable="false"/>
            </column>
            <column name="observation" type="text"/>
            <column name="created_by_id" type="uuid"/>
            <column name="updated_by_id" type="uuid"/>
            <column name="created_at" type="timestamptz">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="timestamptz"/>
            <column name="deleted_at" type="timestamptz"/>
        </createTable>
        <createTable tableName="tasks">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="case_id" type="uuid">
                <constraints nullable="false"/>
            </column>
            <column name="entity_names" type="varchar(150)">
                <constraints nullable="false"/>
            </column>
            <column name="entity_id" type="uuid">
                <constraints nullable="false"/>
            </column>
            <column name="responsible_id" type="uuid">
                <constraints nullable="false"/>
            </column>
            <column name="observation" type="text"/>
            <column name="created_by_id" type="uuid"/>
            <column name="updated_by_id" type="uuid"/>
            <column name="done_at" type="timestamptz"/>
            <column name="created_at" type="timestamptz">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="timestamptz"/>
            <column name="deleted_at" type="timestamptz"/>
        </createTable>

        <addForeignKeyConstraint
                baseTableName="tasks"
                baseColumnNames="case_id"
                constraintName="fk_tasks_case_id"
                referencedTableName="cases"
                referencedColumnNames="id"
                onDelete="RESTRICT"
        />

    </changeSet>
</databaseChangeLog>